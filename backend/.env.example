# ShopSense Backend — Environment Variables Template
# Copy this file to .env and fill in your values before running with Docker.
# Never commit the actual .env file to version control!
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your real values
#   docker-compose up --build

# ── Database ─────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (overrides the hard-coded URL in database.py)
DATABASE_URL=postgresql://postgres:Puskar@2005@db:5432/shopsense_db

# Password used by docker-compose for the postgres container
DB_PASSWORD=Puskar@2005

# ── Security ─────────────────────────────────────────────────────────────────
# Secret key for signing JWT tokens — generate a strong random string for production
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── AI Agent Email (Weekly Vendor Reports) ────────────────────────────────────
# SMTP credentials for sending weekly vendor analysis emails
# For Gmail: use an App Password (not your main password)
#   → Google Account → Security → 2-Step Verification → App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password

# ── Optional: Render / Cloud Deploy ──────────────────────────────────────────
# Set these when deploying to Render.com, Heroku, AWS, etc.
# PORT is used by some cloud providers to specify the listening port
PORT=8010
